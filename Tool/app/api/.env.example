# Copy to .env and adjust. PostgreSQL is the production target (user-managed).
DATABASE_URL=postgresql+psycopg://car:car@localhost:5432/car

# For zero-setup local runs you may instead use SQLite:
# DATABASE_URL=sqlite:///./car_demo.db

# Optional — enables live Anthropic Claude agents. Without it, agents use the
# governed deterministic fallback and the platform still runs fully.
# ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL_REASONING=claude-opus-4-8
CLAUDE_MODEL_NARRATIVE=claude-haiku-4-5-20251001
